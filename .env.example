# ═══ SportDecoded API Keys ═══
# Register at each service (all free tiers)

# Required — AI Tutor
VITE_ANTHROPIC_API_KEY=your_anthropic_key_here

# Cricket — cricapi.com (100 req/day free)
VITE_CRICAPI_KEY=your_cricapi_key_here

# Football — football-data.org (10 req/min free)
VITE_FOOTBALL_DATA_KEY=your_football_data_key_here

# Basketball — balldontlie.io (30 req/min free)
VITE_BALLDONTLIE_KEY=your_balldontlie_key_here

# News — newsapi.org (100 req/day free dev)
VITE_NEWS_API_KEY=your_newsapi_key_here

# F1 — Ergast API (no key needed, free)
# Tennis — Ultimate Tennis Statistics (no key needed, free)
# TheSportsDB — thesportsdb.com (no key needed for basic)

# Build-time only (not client-side)
FIRECRAWL_API_KEY=your_firecrawl_key_here
